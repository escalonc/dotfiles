{{- /* Asked once at `chezmoi init`; stored in this machine's chezmoi config.
       Lets a future Linux *desktop* differ from this Linux *server*. */ -}}
{{- $headless := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if stdinIsATTY -}}
{{-     $headless = promptBoolOnce . "headless" "Headless machine, no GUI apps (yes for a server)" -}}
{{-   else -}}
{{- /* No terminal (e.g. cloud-init `chezmoi init --apply` on the server):
   can't prompt, so assume headless. A Linux desktop is set up interactively. */ -}}
{{-     $headless = true -}}
{{-   end -}}
{{- end -}}
[data]
    headless = {{ $headless }}
