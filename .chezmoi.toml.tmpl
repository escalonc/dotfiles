{{- /* Asked once at chezmoi init; lets a future Linux desktop differ from this Linux server. */ -}}
{{- $headless := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if stdinIsATTY -}}
{{-     $headless = promptBoolOnce . "headless" "Headless machine, no GUI apps (yes for a server)" -}}
{{-   else -}}
{{- /* No terminal (e.g. cloud-init on a server): can't prompt, so assume headless. */ -}}
{{-     $headless = true -}}
{{-   end -}}
{{- end -}}
[data]
    headless = {{ $headless }}
