#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail

# The Brewfile's hash below is what makes Brewfile edits trigger a re-run.
# chezmoi diffs the rendered script content; embedding the hash means the
# script visibly changes whenever the Brewfile changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

if ! command -v brew &>/dev/null; then
  echo "✗ brew not found — run chezmoi apply again to retrigger 00-bootstrap" >&2
  exit 1
fi

echo "→ brew bundle..."
brew bundle --file={{ .chezmoi.sourceDir }}/Brewfile
brew analytics off || true
{{- else }}
exit 0
{{- end }}
