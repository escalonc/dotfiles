[user]
	name = Christopher Escalon
	email = escalonc@users.noreply.github.com

[core]
{{- if eq .chezmoi.os "darwin" }}
	editor = subl --wait
{{- else }}
	editor = nvim
{{- end }}
	autocrlf = input
	excludesfile = ~/.gitignore_global
	pager = delta

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[fetch]
	prune = true

[diff]
	colorMoved = default

[rerere]
	enabled = true

[help]
	# "prompt", not a number: numeric values are DECISECONDS before the guessed
	# command auto-runs (1 = run after 0.1s). prompt asks y/n instead.
	autocorrect = prompt

[merge]
	# Conflict markers include the common-ancestor block, so you can see what
	# BOTH sides changed instead of guessing. Pairs with rerere; delta renders it.
	conflictStyle = zdiff3

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	undo = reset HEAD~1 --mixed
	wip = commit -am 'WIP'
	oops = commit --amend --no-edit
