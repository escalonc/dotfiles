#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail

# The Brewfile's hash below is what makes Brewfile edits trigger a re-run.
# chezmoi diffs the rendered script content; embedding the hash means the
# script visibly changes whenever the Brewfile changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

if ! command -v brew &>/dev/null; then
  echo "✗ brew not found — run chezmoi apply again to retrigger 00-bootstrap" >&2
  exit 1
fi

echo "→ brew bundle..."
brew bundle --file={{ .chezmoi.sourceDir }}/Brewfile
brew analytics off || true
{{- else if eq .chezmoi.os "linux" }}
set -euo pipefail
mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

# Tools Ubuntu (24.04 LTS) ships in its default repos. Ubuntu renames a couple of
# binaries vs upstream (bat→batcat, fd→fdfind) to avoid clashes; symlink them back.
echo "→ apt CLI tools..."
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
  ripgrep fd-find bat fzf zoxide btop tmux direnv neovim \
  git-delta httpie
[ -x /usr/bin/batcat ] && ln -sf /usr/bin/batcat "$HOME/.local/bin/bat"
[ -x /usr/bin/fdfind ] && ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"

# --- Tools NOT in Ubuntu's default repos → release binaries into ~/.local/bin ---
ARCH="$(uname -m)"
dl_tarbin() {  # $1=binary name  $2=tarball URL — extracts the matching binary
  local name=$1 url=$2 tmp
  command -v "$name" >/dev/null 2>&1 && return 0
  echo "→ $name"
  tmp=$(mktemp -d)
  curl -fsSL "$url" | tar -xz -C "$tmp"
  install -m0755 "$(find "$tmp" -type f -name "$name" | head -1)" "$HOME/.local/bin/$name"
  rm -rf "$tmp"
}
# Latest release tag from GitHub's /releases/latest redirect (no API token/jq).
gh_latest() { curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest" | sed 's#.*/tag/##'; }
if [ "$ARCH" = "x86_64" ]; then
  dl_tarbin atuin "https://github.com/atuinsh/atuin/releases/latest/download/atuin-x86_64-unknown-linux-gnu.tar.gz"
  dl_tarbin eza   "https://github.com/eza-community/eza/releases/latest/download/eza_x86_64-unknown-linux-gnu.tar.gz"
  # just/lazygit/gh embed the version in the asset name → resolve the tag first.
  if ! command -v just &>/dev/null; then
    t=$(gh_latest casey/just)              # tag has no leading 'v'
    dl_tarbin just "https://github.com/casey/just/releases/download/${t}/just-${t}-x86_64-unknown-linux-musl.tar.gz"
  fi
  if ! command -v lazygit &>/dev/null; then
    t=$(gh_latest jesseduffield/lazygit); v=${t#v}
    dl_tarbin lazygit "https://github.com/jesseduffield/lazygit/releases/download/${t}/lazygit_${v}_Linux_x86_64.tar.gz"
  fi
  if ! command -v gh &>/dev/null; then
    t=$(gh_latest cli/cli); v=${t#v}
    dl_tarbin gh "https://github.com/cli/cli/releases/download/${t}/gh_${v}_linux_amd64.tar.gz"
  fi
  if ! command -v yq &>/dev/null; then  # we want mikefarah/yq (the Go one)
    echo "→ yq"
    curl -fsSL https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -o "$HOME/.local/bin/yq"
    chmod 0755 "$HOME/.local/bin/yq"
  fi
else
  echo "! non-x86_64 ($ARCH): skipping atuin/eza/just/lazygit/gh/yq — install manually" >&2
fi

# --- fnm (Node manager) into ~/.local/bin; Node LTS comes from 30-languages ---
if ! command -v fnm &>/dev/null && [ ! -x "$HOME/.local/bin/fnm" ]; then
  echo "→ fnm"
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "$HOME/.local/bin" --skip-shell
fi

# --- pnpm (official standalone installer; NOT via npm, per policy) ---
if ! command -v pnpm &>/dev/null && [ ! -x "$HOME/.local/share/pnpm/pnpm" ]; then
  echo "→ pnpm"
  curl -fsSL https://get.pnpm.io/install.sh | env PNPM_HOME="$HOME/.local/share/pnpm" SHELL=bash sh -
fi
{{- else }}
exit 0
{{- end }}
