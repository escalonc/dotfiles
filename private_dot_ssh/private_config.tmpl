# Managed by chezmoi. Put machine-local, untracked hosts in ~/.ssh/config.local
# (same idea as ~/.zshrc.local); ssh silently ignores the Include if it's missing.
Include ~/.ssh/config.local
{{- if eq .chezmoi.os "darwin" }}

# Route all key auth through the 1Password SSH agent (keys never touch disk).
# The 2BUA8C4S2C team ID is fixed — identical on every Mac.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
