#!/usr/bin/env bash
{{- if (.headless | default false) }}
# Headless profile (e.g. the Linux server): no GUI editor, so skip VS Code
# extensions entirely. Gated on the `headless` flag (.chezmoi.toml.tmpl), not the
# OS — a non-headless Linux desktop falls through to the install path below.
exit 0
{{- else }}
set -euo pipefail

# VS Code extensions for a GUI workstation — macOS today, a Linux desktop later.
# Add the macOS VS Code app's `code` CLI to PATH if present; on Linux `code` is
# already a normal binary, so this no-ops.
VSCODE_BIN="/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
[ -d "$VSCODE_BIN" ] && export PATH="$VSCODE_BIN:$PATH"

if ! command -v code &>/dev/null; then
  echo "! VS Code CLI not found — skipping extensions (launch VS Code once first)" >&2
  exit 0
fi

# No AI extensions on purpose (Claude Code in the terminal is the AI layer; the
# managed settings.json disables the built-in AI UI). Python/Rust were cut as
# speculative — not part of the contract-stack rotation.
EXTENSIONS=(
  esbenp.prettier-vscode
  dbaeumer.vscode-eslint
  eamodio.gitlens
  mhutchie.git-graph
  bradlc.vscode-tailwindcss
  ms-vscode.vscode-typescript-next
  prisma.prisma
  tamasfe.even-better-toml
  monokai.theme-monokai-pro-vscode  # theme referenced by the managed settings.json
  ms-vscode-remote.remote-ssh
  ms-vscode-remote.remote-containers
  ms-azuretools.vscode-docker
  redhat.vscode-yaml
  yzhang.markdown-all-in-one
  gruntfuggly.todo-tree
  streetsidesoftware.code-spell-checker
  usernamehw.errorlens
  formulahendry.auto-rename-tag
  christian-kohler.path-intellisense
  mikestead.dotenv
  yoavbls.pretty-ts-errors
)

for ext in "${EXTENSIONS[@]}"; do
  if code --install-extension "$ext" --force &>/dev/null; then
    echo "✓ $ext"
  else
    echo "! skipped: $ext"
  fi
done
{{- end }}
