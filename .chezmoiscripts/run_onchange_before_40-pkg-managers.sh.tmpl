#!/usr/bin/env bash
set -euo pipefail

# PNPM_HOME goes on PATH first so a freshly-installed pnpm (not in the login
# PATH yet) is found.
case "$(uname -s)" in
  Darwin) export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}" ;;
  *)      export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}" ;;
esac
mkdir -p "$PNPM_HOME"
export PATH="$PNPM_HOME:$PATH"

{{ template "dev-env.sh" . }}

if command -v pnpm &>/dev/null; then
  for pkg in typescript tsx; do
    echo "→ pnpm global: $pkg"
    pnpm add -g "$pkg" || echo "! skipped: $pkg" >&2
  done
fi
