#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail

echo "→ Pre-flight: Homebrew"

# Homebrew. chezmoi does not install it; we do. The installer also installs the
# Xcode Command Line Tools, and NONINTERACTIVE=1 does it headlessly (no GUI prompt).
if ! command -v brew &>/dev/null; then
  # NONINTERACTIVE never prompts for a password — it expects sudo to be authorized
  # already, otherwise it aborts with "Need sudo access ... needs to be an
  # Administrator" even for admins. Authorize once, then keep the timestamp warm so
  # the slow CLT + brew install can't hit the 5-minute sudo timeout mid-run.
  echo "  Authorizing sudo (you'll be prompted for your password once)..."
  sudo -v
  while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &
  keepalive_pid=$!
  trap 'kill "$keepalive_pid" 2>/dev/null || true' EXIT

  echo "  Installing Homebrew (installs Xcode CLT headlessly)..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# NOTE: nothing exported here survives this script — each chezmoi run script is
# its own process. Later scripts (10-packages etc.) put brew on their own PATH via
# the dev-env.sh prelude; future login shells get it from the chezmoi-managed
# ~/.zprofile (dot_zprofile.tmpl).
{{- else if eq .chezmoi.os "linux" }}
set -euo pipefail

echo "→ Pre-flight: dnf base packages"
# util-linux-user provides chsh on Fedora.
sudo dnf install -y \
  zsh git curl wget unzip tar gcc gcc-c++ make \
  gnupg2 jq util-linux-user

# Make zsh this user's login shell (no-op if already set).
ZSH_BIN="$(command -v zsh)"
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$ZSH_BIN" ]; then
  sudo chsh -s "$ZSH_BIN" "$USER" || echo "! could not chsh to zsh; set it manually" >&2
fi
{{- else }}
exit 0
{{- end }}
