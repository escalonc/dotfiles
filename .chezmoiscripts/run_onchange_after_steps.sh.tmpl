#!/usr/bin/env bash

set -euo pipefail

# Post-apply steps. run_onchange: re-runs when this rendered script changes
# (e.g. the theme hash below); every step is idempotent.

# Custom themes in ~/.config/bat/themes are only loaded from bat's compiled
# cache; rebuild it whenever the theme file changes.
# theme hash: {{ include "dot_config/bat/themes/Monokai Pro Spectrum.tmTheme" | sha256sum }}
if command -v bat >/dev/null 2>&1; then
  echo "→ Rebuilding bat cache (custom themes)..."
  bat cache --build
fi

# install.sh bootstraps via `chezmoi init escalonc`, which clones over HTTPS
# (a fresh machine has no SSH keys until 1Password is set up). Switch origin
# to SSH so pushes go through the 1Password agent.
url=$(git -C {{ .chezmoi.sourceDir | quote }} remote get-url origin 2>/dev/null) || url=""
if [[ "$url" == https://github.com/escalonc/dotfiles* ]]; then
  echo "→ Switching chezmoi origin to SSH..."
  git -C {{ .chezmoi.sourceDir | quote }} remote set-url origin git@github.com:escalonc/dotfiles.git
fi
