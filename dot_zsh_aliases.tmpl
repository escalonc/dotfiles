# Aliases, sourced from ~/.zshrc. Plain POSIX-ish so it could be shared with
# other shells; anything needing env setup (e.g. EZA_CONFIG_DIR) stays in .zshrc.

# Pager (bat)
if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
  alias less="bat --paging=always"
fi

# List files (eza). l/lsa also override Oh My Zsh's `ls -lah` defaults, which
# would otherwise show hidden files (sourced after oh-my-zsh.sh, so these win).
# Long listings share one flag set: git column, headers, 12-hour dates,
# clickable filenames (OSC 8). Trees honor .gitignore. ll/lm add a per-repo
# branch/status column for directories; lm sorts by mtime with an age-tinted
# date column.
# The time-style newline is intentional: line 1 formats older files (year),
# line 2 recent ones (12-hour clock).
if command -v eza >/dev/null 2>&1; then
  _eza_long="eza -l --icons --group-directories-first --git --header --hyperlink --time-style='+%-d %b  %Y
%-d %b %I:%M %p'"
  alias ls="eza --icons --group-directories-first --hyperlink"
  alias l="$_eza_long"
  alias ll="$_eza_long --git-repos"
  alias la="$_eza_long -a"
  alias lsa="$_eza_long -a"
  alias lm="$_eza_long --git-repos --sort=modified --color-scale=age"
  alias lt="eza --tree --icons --level=2 --git-ignore --hyperlink"
  alias ltt="eza --tree --icons --level=3 --git-ignore --hyperlink"
  unset _eza_long
fi

# Docker
alias d="docker"
alias dc="docker compose"
alias dex="docker exec -it"
alias drmi="docker rmi"
alias dprune="docker system prune -a"

# Claude Code
alias c="claude"

# Misc
alias reload="source ~/.zshrc"
alias myip="curl -s ifconfig.me; echo"
{{- if eq .chezmoi.os "darwin" }}
alias zshconfig="subl ~/.zshrc"
alias ohmyzsh="subl ~/.oh-my-zsh"
alias hosts="sudo subl /etc/hosts"
alias localip="ipconfig getifaddr en0"
alias flushdns="sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && echo 'DNS flushed'"
alias cleanup="find . -name '.DS_Store' -delete"
alias brewup="brew update && brew upgrade && brew cleanup"
{{- else }}
alias zshconfig='$EDITOR ~/.zshrc'
alias ohmyzsh='$EDITOR ~/.oh-my-zsh'
alias hosts='sudo $EDITOR /etc/hosts'
alias localip="hostname -I | awk '{print \$1}'"
alias flushdns="sudo resolvectl flush-caches && echo 'DNS flushed'"
{{- end }}
alias ports="sudo lsof -i -P -n | grep LISTEN"
