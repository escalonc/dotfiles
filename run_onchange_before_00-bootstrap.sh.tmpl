#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail

echo "→ Pre-flight: Homebrew"

# Homebrew. chezmoi does not install it; we do. The installer also installs the
# Xcode Command Line Tools, and NONINTERACTIVE=1 does it headlessly (no GUI prompt).
if ! command -v brew &>/dev/null; then
  # NONINTERACTIVE never prompts for a password — it expects sudo to be authorized
  # already, otherwise it aborts with "Need sudo access ... needs to be an
  # Administrator" even for admins. Authorize once, then keep the timestamp warm so
  # the slow CLT + brew install can't hit the 5-minute sudo timeout mid-run.
  echo "  Authorizing sudo (you'll be prompted for your password once)..."
  sudo -v
  while true; do sudo -n true; sleep 60; kill -0 "$$" 2>/dev/null || exit; done 2>/dev/null &
  keepalive_pid=$!
  trap 'kill "$keepalive_pid" 2>/dev/null || true' EXIT

  echo "  Installing Homebrew (installs Xcode CLT headlessly)..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Make brew available for the subsequent chezmoi scripts in THIS run (10-packages
# etc. need it on PATH). Future login shells get it from the chezmoi-managed
# ~/.zprofile (dot_zprofile.tmpl), applied right after these before-scripts.
# Apple Silicon only (/opt/homebrew).
eval "$(/opt/homebrew/bin/brew shellenv zsh)"
{{- else if eq .chezmoi.os "linux" }}
set -euo pipefail

echo "→ Pre-flight: apt base packages"
# build-essential pulls in gcc/g++/make; chsh ships in passwd (preinstalled).
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
  zsh git git-lfs curl wget unzip tar build-essential \
  gnupg jq ca-certificates

# Make zsh this user's login shell (no-op if already set).
ZSH_BIN="$(command -v zsh)"
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$ZSH_BIN" ]; then
  sudo chsh -s "$ZSH_BIN" "$USER" || echo "! could not chsh to zsh; set it manually" >&2
fi

# 1Password CLI (op) — chezmoi templates use it (stage 3) to fetch secrets.
if ! command -v op &>/dev/null; then
  echo "→ Installing 1Password CLI (op)..."
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc \
    | sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg
  echo "deb [arch=amd64 signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/amd64 stable main" \
    | sudo tee /etc/apt/sources.list.d/1password.list >/dev/null
  # debsig verification policy (apt installs the .deb signed against this).
  sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22/
  curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol \
    | sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol >/dev/null
  sudo mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc \
    | sudo gpg --dearmor --output /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y 1password-cli
fi
{{- else }}
exit 0
{{- end }}
