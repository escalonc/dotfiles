#!/usr/bin/env bash
{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail

echo "→ Pre-flight: Xcode Command Line Tools + Homebrew"

# Xcode CLT — required by Homebrew and git.
if ! xcode-select -p &>/dev/null; then
  echo "  Installing Xcode Command Line Tools (a GUI prompt will appear)..."
  xcode-select --install || true
  until xcode-select -p &>/dev/null; do
    sleep 5
  done
fi

# Homebrew. chezmoi does not install it; we do.
if ! command -v brew &>/dev/null; then
  echo "  Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Make brew available for subsequent chezmoi scripts in this run.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Persist brew shellenv in ~/.zprofile for future login shells.
touch "$HOME/.zprofile"
if ! grep -qE '^[[:space:]]*eval.*brew shellenv' "$HOME/.zprofile"; then
  prefix=$([ -x /opt/homebrew/bin/brew ] && echo /opt/homebrew || echo /usr/local)
  echo "eval \"\$($prefix/bin/brew shellenv)\"" >> "$HOME/.zprofile"
fi
{{- else }}
# Linux bootstrap goes here when added — apt/pacman/dnf, brew on linuxbrew, etc.
exit 0
{{- end }}
