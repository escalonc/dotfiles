# OpenTofu / Terraform — never commit state or real variable values.

# State — gitignored as good practice (it can capture sensitive values).
*.tfstate
*.tfstate.*

# Real values (your IP, overrides) live here; keep local...
*.tfvars
# ...but DO track the example template.
!*.tfvars.example

# Downloaded provider binaries — large, machine-specific.
.terraform/

crash.log
crash.*.log

# Note: .terraform.lock.hcl is intentionally NOT ignored — commit it so everyone
# (and future you) installs the exact same provider versions.
