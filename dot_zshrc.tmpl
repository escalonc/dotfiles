# ── Powerlevel10k instant prompt (must stay near the top) ────────────────────
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── Oh My Zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Never nag about updates: the self-updater is fully off — OMZ (and p10k + plugins)
# are refreshed weekly by chezmoi instead (.chezmoiexternal.toml), with no interaction.
zstyle ':omz:update' mode disabled

# Trimmed (2026-06-10) to plugins that do passive work — completions and key
# widgets — plus the `git` alias pack, kept deliberately. A cut plugin is one
# line to restore.
plugins=(
  git
  gh
  zsh-autosuggestions
  docker
  sudo
  colored-man-pages
)
# NOTE: zsh-syntax-highlighting is deliberately NOT in this array — it's sourced
# manually as the LAST line of this file, per upstream's recommendation.

# zsh-completions: NOT in the plugins array (upstream: loading it as a plugin
# adds its functions after compinit already ran → redundant .zcompdump rebuilds).
# On fpath BEFORE oh-my-zsh.sh, whose own compinit then picks everything up once.
# No compinit call here for the same reason — oh-my-zsh runs it.
fpath+="$ZSH/custom/plugins/zsh-completions/src"

source "$ZSH/oh-my-zsh.sh"

# ── PATH ─────────────────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
export HOMEBREW_NO_ANALYTICS=1
{{- end }}

export PATH="$HOME/.local/bin:$PATH"

# ── Language Managers ────────────────────────────────────────────────────────
# Guard each so a missing/uninstalled tool doesn't spam errors on shell startup.
command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd --shell zsh)"

# pnpm global bin
{{- if eq .chezmoi.os "darwin" }}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else }}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ── Tool Config ──────────────────────────────────────────────────────────────
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --reverse --border --preview "bat --style=numbers --color=always --line-range :500 {}"'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Ships with bat — also picked up by delta (it falls back to BAT_THEME for syntax).
export BAT_THEME="Catppuccin Mocha"
if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
  alias less="bat --paging=always"
fi

# ── Aliases ──────────────────────────────────────────────────────────────────

# List files (eza)
if command -v eza >/dev/null 2>&1; then
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -la --icons --group-directories-first --git"
  alias la="eza -a --icons"
  alias lt="eza --tree --icons --level=2"
  alias ltt="eza --tree --icons --level=3"
fi

# Docker
alias d="docker"
alias dc="docker compose"
alias dex="docker exec -it"
alias drmi="docker rmi"
alias dprune="docker system prune -a"

# Claude Code
alias c="claude"

# Misc
alias reload="source ~/.zshrc"
alias myip="curl -s ifconfig.me; echo"
{{- if eq .chezmoi.os "darwin" }}
alias zshconfig="subl ~/.zshrc"
alias ohmyzsh="subl ~/.oh-my-zsh"
alias hosts="sudo subl /etc/hosts"
alias localip="ipconfig getifaddr en0"
alias flushdns="sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && echo 'DNS flushed'"
alias cleanup="find . -name '.DS_Store' -delete"
alias brewup="brew update && brew upgrade && brew cleanup"
{{- else }}
alias zshconfig='$EDITOR ~/.zshrc'
alias ohmyzsh='$EDITOR ~/.oh-my-zsh'
alias hosts='sudo $EDITOR /etc/hosts'
alias localip="hostname -I | awk '{print \$1}'"
alias flushdns="sudo resolvectl flush-caches && echo 'DNS flushed'"
{{- end }}
alias ports="sudo lsof -i -P -n | grep LISTEN"

# ── Functions ────────────────────────────────────────────────────────────────

gclone() { git clone "$1" && cd "$(basename "$1" .git)" || return; }

serve() { python3 -m http.server "${1:-8080}"; }

killport() {
  local pids; pids=$(lsof -ti tcp:"$1")
  if [[ -n $pids ]]; then
    # ${(f)…} splits on newlines — zsh doesn't word-split unquoted parameters,
    # so a bare $pids with multiple PIDs would reach kill as ONE bogus argument.
    kill -9 ${(f)pids}
  else
    echo "No process on port $1"
  fi
}

whatsport() { sudo lsof -i :"$1"; }

extract() {
  if [ -f "$1" ]; then
    case $1 in
      *.tar.bz2) tar xjf "$1"    ;;
      *.tar.gz)  tar xzf "$1"    ;;
      *.tar.xz)  tar xJf "$1"    ;;
      *.bz2)     bunzip2 "$1"    ;;
      *.gz)      gunzip "$1"     ;;
      *.xz)      unxz "$1"       ;;
      *.tar)     tar xf "$1"     ;;
      *.tbz2)    tar xjf "$1"    ;;
      *.tgz)     tar xzf "$1"    ;;
      *.zip)     unzip "$1"      ;;
      *.Z)       uncompress "$1" ;;
      *)         echo "'$1' cannot be extracted" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

hist() { history | grep "$1"; }

weather() { curl "wttr.in/${1:-}"; }

jwt-decode() {
  jq -R 'split(".") | .[0],.[1] | @base64d | fromjson' <<< "$1"
}

# ── Environment ──────────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
export EDITOR="subl --wait"
{{- else }}
export EDITOR="nvim"
{{- end }}
export VISUAL="$EDITOR"
export HISTSIZE=50000
export SAVEHIST=50000
export HIST_STAMPS="yyyy-mm-dd"

# ── Powerlevel10k config ─────────────────────────────────────────────────────
# `|| source` (not `&& source`): a missing file must leave $? = 0, or the first
# prompt of every new shell renders a phantom error-status segment.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ── Local overrides ──────────────────────────────────────────────────────────
[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local

# ── Syntax highlighting — MUST stay the last thing sourced ───────────────────
# It wraps every ZLE widget that exists at source time; anything loaded after it
# (fzf, zoxide, p10k, local overrides) wouldn't be highlighted. That's also why
# it's sourced manually here instead of via the OMZ plugins array, which runs
# mid-file — exactly what upstream's "manual install, last sourced" advice means.
ZSYH="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ ! -f $ZSYH ]] || source "$ZSYH"
unset ZSYH
