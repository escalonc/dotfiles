# ── Powerlevel10k instant prompt (must stay near the top) ────────────────────
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── Oh My Zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# OMZ + plugins are refreshed by chezmoi (.chezmoiexternal.toml); never self-update.
zstyle ':omz:update' mode disabled

plugins=(
  git
  gh
  zsh-autosuggestions
  docker
  sudo
  colored-man-pages
)

# zsh-completions on fpath BEFORE oh-my-zsh so compinit sees it (as a plugin it loads too late).
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
autoload -U compinit && compinit

# OMZ reads this at source time (lib/history.zsh builds the `history` alias from it).
HIST_STAMPS="yyyy-mm-dd"

source "$ZSH/oh-my-zsh.sh"

# ── PATH ─────────────────────────────────────────────────────────────────────
# User-local binaries (claude; fnm on Linux); in .zshrc not .zprofile so tmux panes get it too.
export PATH="$HOME/.local/bin:$PATH"

# ── Language Managers ────────────────────────────────────────────────────────
# Guard each so a missing/uninstalled tool doesn't spam errors on shell startup.
command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd --shell zsh)"

# ── Tool Config ──────────────────────────────────────────────────────────────
# Without this, eza looks for theme.yml in ~/Library/Application Support on
# macOS; pin the XDG path (where chezmoi puts it) on both OSes.
export EZA_CONFIG_DIR="$HOME/.config/eza"

# ── Aliases ──────────────────────────────────────────────────────────────────
[[ ! -f ~/.zsh_aliases ]] || source ~/.zsh_aliases

# ── Functions ────────────────────────────────────────────────────────────────
[[ ! -f ~/.zsh_functions ]] || source ~/.zsh_functions

# ── Environment ──────────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
export EDITOR="subl --wait"
{{- else }}
export EDITOR="vi"
{{- end }}
export VISUAL="$EDITOR"
export HISTSIZE=50000
export SAVEHIST=50000

# ── Powerlevel10k config ─────────────────────────────────────────────────────
# ||-form keeps $? = 0 when the file is missing (else first prompt shows an error).
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
# Ink overrides — must come after ~/.p10k.zsh so its styles win.
[[ ! -f ~/.config/zsh/p10k-ink.zsh ]] || source ~/.config/zsh/p10k-ink.zsh

# zoxide docs: init at the end of .zshrc (must run after compinit; only
# syntax-highlighting may follow, since it wraps existing widgets).
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# ── Syntax highlighting — MUST stay the last thing sourced ───────────────────
# Wraps existing ZLE widgets (zoxide/p10k above), so must be manual and last — not in the plugins array.
ZSYH="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ ! -f $ZSYH ]] || source "$ZSYH"
unset ZSYH
