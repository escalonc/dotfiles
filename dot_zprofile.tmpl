# vim: set ft=sh:
{{- if eq .chezmoi.os "darwin" }}
# Homebrew environment (PATH, MANPATH, …) for login shells. Apple Silicon only.
# Guarded so a Mac mid-bootstrap (brew not installed yet) doesn't error every login.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv zsh)"

# Editor CLI on PATH (only if the app is installed).
[[ -d "/Applications/Sublime Text.app/Contents/SharedSupport/bin" ]] && \
  export PATH="/Applications/Sublime Text.app/Contents/SharedSupport/bin:$PATH"
{{- end }}
# Linux needs nothing here — ~/.local/bin is set in .zshrc so it also reaches
# non-login shells (tmux panes on the devbox); brew shellenv above is macOS-only.
