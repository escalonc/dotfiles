# vim: set ft=sh:
{{- if eq .chezmoi.os "darwin" }}
# Homebrew env for login shells (Apple Silicon); guarded so a mid-bootstrap Mac (no brew yet) doesn't error.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv zsh)"

# Editor CLI on PATH (only if the app is installed).
[[ -d "/Applications/Sublime Text.app/Contents/SharedSupport/bin" ]] && \
  export PATH="/Applications/Sublime Text.app/Contents/SharedSupport/bin:$PATH"

# JetBrains Toolbox CLI launchers (idea, webstorm, ...); Toolbox appends this
# itself if missing, so keep it managed here to avoid apply conflicts.
[[ -d "$HOME/Library/Application Support/JetBrains/Toolbox/scripts" ]] && \
  export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"

# VS Code CLI (code) on PATH (only if the app is installed).
[[ -d "/Applications/Visual Studio Code.app/Contents/Resources/app/bin" ]] && \
  export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
{{- end }}
# Linux needs nothing here — ~/.local/bin is set in .zshrc (reaches tmux panes too); brew above is macOS-only.
