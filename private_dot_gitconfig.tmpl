	name = Christopher Escalon
	email = escalonc@users.noreply.github.com
{{- if eq .chezmoi.os "darwin" }}
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOVhkuty5mPaG9oq071nCjRM3/SCJfHckcD2owYeuuU7
{{- end }}

[core]
{{- if eq .chezmoi.os "darwin" }}
	editor = subl --wait
{{- else }}
	editor = vi
{{- end }}
	autocrlf = input
	excludesfile = ~/.gitignore_global
	pager = delta

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true
	# Push annotated tags that point at commits being pushed (no separate --tags).
	followTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	# Keep stacked-branch refs pointing at the right commits when rebasing a stack.
	updateRefs = true

[fetch]
	prune = true

[branch]
	# List branches most-recently-committed first instead of alphabetically.
	sort = -committerdate

[tag]
	# Companion to branch.sort: order tags by version, newest first.
	sort = -version:refname

[column]
	# Multi-column output (branch/tag/status) when writing to a terminal, like ls.
	ui = auto

[diff]
	colorMoved = default
	# Cleaner, better-aligned hunks than the default myers, esp. on moved code.
	algorithm = histogram

[rerere]
	enabled = true

[help]
	# "prompt" (not a number): numeric values are deciseconds before auto-run; prompt asks y/n instead.
	autocorrect = prompt

[merge]
	# zdiff3 shows the common-ancestor block in conflicts; pairs with rerere, delta renders it.
	conflictStyle = zdiff3

[interactive]
	diffFilter = delta --color-only

[delta]
	# Custom theme from dot_config/bat/themes (needs `bat cache --build` once).
	syntax-theme = Monokai Pro Spectrum
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	undo = reset HEAD~1 --mixed
	wip = commit -am 'WIP'
	oops = commit --amend --no-edit
{{- if eq .chezmoi.os "darwin" }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
{{- end }}
